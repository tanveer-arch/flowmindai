# FlowMind AI — Environment Variables
# Copy this file to .env and fill in your actual values.

# ---------------------------------------------------------------------------
# Required — LLM
# ---------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# ---------------------------------------------------------------------------
# Google OAuth (Member 1 — Authentication)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/callback

# ---------------------------------------------------------------------------
# App URLs
# ---------------------------------------------------------------------------
FRONTEND_URL=http://127.0.0.1:5500
BACKEND_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------
SESSION_SECRET=your_random_secret_key_here

# ---------------------------------------------------------------------------
# MCP-enabled tools (GitHub, Sheets, Email via real MCP servers)
# ---------------------------------------------------------------------------
GITHUB_TOKEN=your_github_personal_access_token_here
GOOGLE_SHEETS_CREDENTIALS=path/to/gdrive-credentials.json
EMAIL_ADDRESS=your.email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password_here

# ---------------------------------------------------------------------------
# Jira REST API (optional — falls back to mock if not set)
# ---------------------------------------------------------------------------
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=your.email@company.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=JRA
